target/
.pixie/
# The [crates] binding cache is COMMITTED (collaborators and the tier
# gate must not need the doc nightly) — un-ignore exactly that dir.
!examples/pkg/.pixie/
examples/pkg/.pixie/*
!examples/pkg/.pixie/rpi/

# The rpi-gen fixture is a standalone crate regenerated by hand when
# the shapes it covers change; its lockfile is a build artifact.
crates/pixie-rpi-gen/tests/fixture/Cargo.lock

# pixie-py: built extension module + python cache
crates/yokan/yokan.so
__pycache__/
**/.gate/
crates/yokan/uv.lock
dist/
.yokan/

# private working ledger — never tracked
crates/yokan/DESIGN.local.md
docs/WIDGET_PLAYBOOK.local.md
docs/WIDGET_GAPS.local.md
crates/yokan/BACKLOG.local.md
crates/yokan/tools/probe_dialect.local.py
