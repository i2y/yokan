store Panes {
  state ratio : Float = 0.5
  state rows : Float = 0.35
  state fruits : List<String> = ["apple", "banana", "cherry"]
  state pick : Int = 0
}

view Main {
  Column {
    grow: 1.0
    Text { text: "ratio: #{Panes.ratio} rows: #{Panes.rows} pick: #{Panes.pick}" }
    Split {
      ratio: Panes.ratio
      onChange: {
        Panes.ratio = value
      }
      Column {
        background: "#313244"
        padding: 12.0
        Text { text: "left" }
        # A chooser beside a divider: the select step has to walk
        # into a pane, the way the click step already did.
        Select { options: Panes.fruits; selected: Panes.pick; onSelect: { Panes.pick = index } }
      }
      Split {
        ratio: Panes.rows
        vertical: true
        onChange: {
          Panes.rows = value
        }
        Column {
          background: "#45475a"
          padding: 12.0
          Text { text: "top right" }
        }
        Column {
          background: "#181825"
          padding: 12.0
          Text { text: "bottom right" }
        }
      }
    }
  }
}
