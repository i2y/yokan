# Keys: a chord is a DECLARATION on the store, the way a timer is.
# The spelling is the platform's own (`cmd-s`, `shift-tab`), and a
# headless `key:<chord>` step presses one — so a shortcut is a
# checked interaction, not something only a human can reach. A menu
# item is the same declaration wearing a name (`menu:<item>` picks
# one), and the window hands the bar to the platform.

store App {
  state count : Int = 0
  state saved : Int = 0
  state last : String = "-"
  state moved : Int = 0
  state fired : Int = 0
  state lifted : Int = 0

  fn bump {
    count += 1
  }

  fn save @key("cmd-s") {
    saved = count
  }

  fn saveFromMenu @menu("Count", "Save") {
    saved = count
  }

  fn clear @key("cmd-shift-r") {
    count = 0
    saved = 0
  }

  fn typed(k: String) @key {
    last = k
  }

  # The other question a keyboard answers: not "which chord was
  # pressed" but "is left held right now". A tick reads it — a view
  # never does, because a view is rebuilt on the framework's schedule
  # and what it read would be a moment the app never chose.
  #
  # `pressed` is emptied by the tick that saw it, so `fired` counts
  # taps, not frames: holding space is one shot, and a script's
  # `keydown:space` between two `advance:` steps proves it.
  fn tick @every(50) {
    if Keys.down("left") {
      moved -= 1
    }
    if Keys.down("right") {
      moved += 1
    }
    if Keys.pressed("space") {
      fired += 1
    }
    if Keys.released("space") {
      lifted += 1
    }
  }
}

view Main {
  Column {
    spacing: 8
    padding: 12
    Text { text: "count=#{App.count} saved=#{App.saved} last=#{App.last}" }
    Text { text: "moved=#{App.moved} fired=#{App.fired} lifted=#{App.lifted}" }
    Button { text: "+1"; onClick: App.bump() }
  }
}
