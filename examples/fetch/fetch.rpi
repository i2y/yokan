# Bindings for the async demo. `await Binding.f(...)` ships the same
# adapters to a worker thread; called without `await` they run inline.

class Fs {
  static fn readToString(path: String) !String @rust("std::fs::read_to_string")
  static fn writeString(path: String, contents: String) !Void @rust("std::fs::write")
}

class Clock {
  static fn sleepMs(ms: Int) @rust("pixie_kernel::sleep_ms")
}
