# A canvas is a grid of virtual pixels an app paints command by
# command. `width`/`height` count those pixels and `scale` says how
# many logical ones each of them takes, so this one is 48x24 drawn at
# six — 288x144 of layout. Every color is an INDEX into `palette`,
# which is why a frame written for a pixel machine reads the same here.
#
# The commands are not elements: nothing in a canvas can be clicked,
# themed, sized or animated, and none of them appears in the
# accessibility tree (the canvas itself is an image there). What they
# ARE is data, so the dump prints the whole frame, one command per
# line, and the tier gate compares it.

struct Blip {
  var x : Int
  var y : Int
  var c : Int
}

store Sky {
  state frame : Int = 0
  state blips : List<Blip> = []
  # Four colors are enough to show that the index IS the color; the
  # fifth is the sheet's ground, because `colkey` is an index too — a
  # sprite sheet and the canvas it lands on share one palette.
  state palette : List<String> = ["#11111b", "#89b4fa", "#f38ba8", "#eeeeee", "#ff00ff"]

  fn seed {
    blips = [Blip(6, 4, 1), Blip(20, 9, 2), Blip(33, 6, 3)]
  }

  fn tick @every(100) {
    frame += 1
  }
}

view Main {
  Column {
    spacing: 8
    padding: 12
    Text { text: "frame #{Sky.frame}, blips #{Sky.blips.length}" }
    Canvas {
      width: 48
      height: 24
      scale: 6
      background: 0
      palette: Sky.palette
      Rect { x: 2; y: 2; w: 10; h: 6; color: 1 }
      RectOutline { x: 14; y: 2; w: 10; h: 6; color: 2 }
      Circle { x: 30; y: 5; r: 4; color: 3 }
      CircleOutline { x: 41; y: 5; r: 4; color: 1 }
      Line { x1: 2; y1: 11; x2: 45; y2: 11; color: 2 }
      Triangle { x1: 3; y1: 22; x2: 8; y2: 14; x3: 13; y3: 22; color: 3 }
      TriangleOutline { x1: 16; y1: 22; x2: 21; y2: 14; x3: 26; y3: 22; color: 1 }
      # A sprite is a rectangle of another image, copied in. `colkey`
      # is the color that is not copied — the sheet has no alpha, so
      # its magenta ground is the key.
      Sprite { x: 29; y: 14; source: "examples/canvas/sheet.png"; u: 0; v: 0; w: 8; h: 8; colkey: 4 }
      Sprite { x: 38; y: 14; source: "examples/canvas/sheet.png"; u: 8; v: 0; w: 8; h: 8; colkey: 4; flipX: true }
      # A `for` inside a canvas is the ordinary repeater: the commands
      # a row contributes join the frame where they stand.
      for b in Sky.blips {
        Pixel { x: b.x; y: b.y; color: b.c }
      }
      PixelText { x: 2; y: 15; text: "#{Sky.frame}"; color: 3 }
    }
    Button { text: "seed"; onClick: Sky.seed() }
  }
}
