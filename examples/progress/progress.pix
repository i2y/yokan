store Job {
  state ratio : Float = 0.25

  fn step {
    ratio = ratio + 0.25
  }
}

view Main {
  Column {
    ProgressBar { value: Job.ratio }
    Text { text: "ratio: #{Job.ratio}" }
    Button { text: "step"; onClick: Job.step() }
    ProgressBar { value: Job.ratio; width: 220.0; height: 10.0; label: "Uploading" }
    ProgressBar { value: Job.ratio; indeterminate: true }
  }
}
